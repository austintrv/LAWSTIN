{
  "name": "lawstin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "study:check": "tsx scripts/validate-study-materials.ts",
    "study:preflight": "tsx scripts/study-preflight.ts",
    "study:publish": "tsx scripts/publish-study-batch.ts",
    "sync:desktop": "node scripts/sync-desktop.mjs",
    "context:test": "npm --prefix tools/course-context test",
    "context:package": "npm --prefix tools/course-context run package",
    "context:setup": "npm run context:package && node '.context-build/LAWSTIN Course Setup/setup.cjs'",
    "context:check": "node tools/course-context/cli.mjs doctor",
    "context:cloud-prepare": "node scripts/prepare-cloud-function.mjs",
    "context:cloud-package": "node tools/course-context/build-cloud-package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
