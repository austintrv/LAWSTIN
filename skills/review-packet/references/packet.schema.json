{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAWSTIN review packet v1",
  "type": "object",
  "required": [
    "version",
    "title",
    "instructions",
    "sections",
    "tomorrow"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "instructions": {
      "type": "string",
      "pattern": "\\S"
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/matching"
          },
          {
            "$ref": "#/$defs/true-false"
          },
          {
            "$ref": "#/$defs/direct-rule"
          },
          {
            "$ref": "#/$defs/hypothetical"
          },
          {
            "$ref": "#/$defs/short-response"
          }
        ]
      },
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "matching"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "true-false"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "direct-rule"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "hypothetical"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "short-response"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "tomorrow": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/tomorrow"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "writing": {
      "type": "object",
      "required": [
        "prompt",
        "model",
        "criteria"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "required": [
        "model",
        "criteria"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": [
        "id",
        "text",
        "why"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "why": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "matchingQuestion": {
      "type": "object",
      "required": [
        "id",
        "text",
        "topics",
        "tasks",
        "source",
        "explanation",
        "correctId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "recall",
              "recognition",
              "application"
            ]
          }
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "pattern": "\\S"
        },
        "caseIdentification": {
          "type": "string",
          "pattern": "\\S"
        },
        "challenge": {
          "type": "string",
          "pattern": "\\S"
        },
        "correctId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "recall": {
          "$ref": "#/$defs/writing"
        }
      },
      "additionalProperties": false
    },
    "matching": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "questions",
        "definitions"
      ],
      "properties": {
        "kind": {
          "const": "matching"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/matchingQuestion"
          }
        },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        }
      },
      "additionalProperties": false
    },
    "true-falseQuestion": {
      "type": "object",
      "required": [
        "id",
        "text",
        "topics",
        "tasks",
        "source",
        "explanation",
        "truth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "recall",
              "recognition",
              "application"
            ]
          }
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "pattern": "\\S"
        },
        "caseIdentification": {
          "type": "string",
          "pattern": "\\S"
        },
        "challenge": {
          "type": "string",
          "pattern": "\\S"
        },
        "truth": {
          "type": "boolean"
        },
        "repair": {
          "$ref": "#/$defs/key"
        },
        "justification": {
          "$ref": "#/$defs/writing"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "truth": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "repair"
        ]
      }
    },
    "true-false": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "true-false"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/true-falseQuestion"
          }
        }
      },
      "additionalProperties": false
    },
    "direct-ruleQuestion": {
      "type": "object",
      "required": [
        "id",
        "text",
        "topics",
        "tasks",
        "source",
        "explanation",
        "correctId",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "recall",
              "recognition",
              "application"
            ]
          }
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "pattern": "\\S"
        },
        "caseIdentification": {
          "type": "string",
          "pattern": "\\S"
        },
        "challenge": {
          "type": "string",
          "pattern": "\\S"
        },
        "correctId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "recall": {
          "$ref": "#/$defs/writing"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      },
      "additionalProperties": false
    },
    "direct-rule": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "direct-rule"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/direct-ruleQuestion"
          }
        }
      },
      "additionalProperties": false
    },
    "hypotheticalQuestion": {
      "type": "object",
      "required": [
        "id",
        "text",
        "topics",
        "tasks",
        "source",
        "explanation",
        "correctId",
        "choices",
        "facts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "recall",
              "recognition",
              "application"
            ]
          }
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "pattern": "\\S"
        },
        "caseIdentification": {
          "type": "string",
          "pattern": "\\S"
        },
        "challenge": {
          "type": "string",
          "pattern": "\\S"
        },
        "correctId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "recall": {
          "$ref": "#/$defs/writing"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "facts": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "hypothetical": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "hypothetical"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hypotheticalQuestion"
          }
        }
      },
      "additionalProperties": false
    },
    "short-responseQuestion": {
      "type": "object",
      "required": [
        "id",
        "text",
        "topics",
        "tasks",
        "source",
        "explanation",
        "key"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "recall",
              "recognition",
              "application"
            ]
          }
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "pattern": "\\S"
        },
        "caseIdentification": {
          "type": "string",
          "pattern": "\\S"
        },
        "challenge": {
          "type": "string",
          "pattern": "\\S"
        },
        "key": {
          "$ref": "#/$defs/key"
        }
      },
      "additionalProperties": false
    },
    "short-response": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "questions"
      ],
      "properties": {
        "kind": {
          "const": "short-response"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/short-responseQuestion"
          }
        }
      },
      "additionalProperties": false
    },
    "tomorrow": {
      "type": "object",
      "required": [
        "id",
        "text",
        "key",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  },
  "description": "Include each section kind once. Question and tomorrow IDs are unique across the packet. Each correctId references a choice in the question or its section’s definition bank. Choice and definition IDs are unique within their bank. Run check.mjs for the cross-reference checks."
}
